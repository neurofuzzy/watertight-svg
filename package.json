{
  "name": "watertight-svg",
  "private": true,
  "version": "1.0.3",
  "description": "A high-performance geometric optimizer for SVG paths, designed for plotters, laser cutters, and CNC machines.",
  "keywords": [
    "svg",
    "optimizer",
    "plotter",
    "axidraw",
    "cnc",
    "geometry",
    "path-finding",
    "TSP",
    "visualization",
    "simulator",
    "simulation",
    "path-planning"
  ],
  "author": "Geoff",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "wasm:build": "cd wasm && wasm-pack build --target web --out-dir ../src/wasm-pkg"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}