{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src"
    ],
    // These import src/wasm-pkg/, which `npm run wasm:build` generates and
    // .gitignore excludes - so a fresh clone (and CI) has no such module.
    // Nothing imports either file today; the pipeline calls the TypeScript
    // findRegions directly. Skipping them keeps `npm run build` working from a
    // clean checkout. Drop this once WASM is actually wired into the pipeline.
    "exclude": [
        "src/optimize/wasm-bridge.ts",
        "src/optimize/regions-wasm.ts"
    ]
}